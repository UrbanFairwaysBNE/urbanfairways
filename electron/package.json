{
  "name": "urban-fairways-bay-controller",
  "version": "1.0.0",
  "description": "Bay Controller for Urban Fairways indoor golf simulators",
  "main": "main.js",
  "author": "Urban Fairways",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "au.com.urbanfairways.baycontroller",
    "productName": "UF Bay Controller",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "main.js",
      "preload.js",
      "obs-controller.js",
      "hole-splitter.js",
      "icon.png"
    ],
    "extraResources": [
      {
        "from": "../dist-electron-app",
        "to": "dist",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "tapo_control.exe",
        "to": "tapo_control.exe"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "UrbanFairwaysBNE",
      "repo": "urbanfairways"
    },
    "win": {
      "target": "nsis",
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "shortcutName": "UF Bay Controller",
      "artifactName": "UFBayController-Setup-${version}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "electron-updater": "^6.1.7",
    "ffmpeg-static": "^5.2.0",
    "tp-link-tapo-connect": "^1.0.7",
    "uuid": "^9.0.0",
    "ws": "^8.18.0"
  }
}
